// Serves site/ at https://herdrui.dev from Cloudflare Workers static assets.
// Deployed by .github/workflows/site.yml; see site/README.md.
{
  "$schema": "https://unpkg.com/wrangler@4.144.0/config-schema.json",
  "name": "herdrui-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "herdrui.dev", "custom_domain": true },
    { "pattern": "www.herdrui.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    // Without this, a www request for an existing file would be served from the
    // assets and never reach the Worker's redirect.
    "run_worker_first": true
  }
}
